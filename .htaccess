# S&S Cargo Freight OS — Apache config

DirectoryIndex index.php index.html

# Never serve raw SQL, backups or config over HTTP.
<FilesMatch "\.(sql|bak|md|txt|log)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Block direct access to the includes and database folders.
  RewriteRule ^(includes|database|partials)/ - [F,L]
</IfModule>

# Long cache for fingerprinted assets (index.php appends ?v=mtime).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css        "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Sensible defaults; harmless if the host overrides them.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "same-origin"
</IfModule>
